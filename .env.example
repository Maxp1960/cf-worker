# Cloudflare Account Credentials (Used by CLI / Auth scripts)
# DO NOT commit real secrets here. Copy to .env and configure.

# Cloudflare API Token (Requires Worker, R2, and Access permissions)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID (Found on Cloudflare dashboard right-hand side)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Target Cloudflare R2 Bucket Name for flag assets
R2_BUCKET_NAME=country-flags

# Optional: Cloudflare Access Team / Audience (AUD) tag for JWT validation
CF_ACCESS_AUD=your_access_application_aud_tag_here
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
